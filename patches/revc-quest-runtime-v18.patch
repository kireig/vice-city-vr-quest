+static bool
+ShouldUseXboxArchiveEntry(const char *extension, int modelId)
+{
+	if(!ModelSets::IsXboxActive())
+		return false;
+	if(strncasecmp(extension, "DFF", 3) == 0)
+		return GetModelSetCategory(modelId) == ModelSets::MODEL_CATEGORY_VEHICLES;
+	if(strncasecmp(extension, "TXD", 3) == 0){
+		for(int i = 0; i < MODELINFOSIZE; i++){
+			CBaseModelInfo *model = CModelInfo::GetModelInfo(i);
+			if(model && model->GetModelType() == MITYPE_VEHICLE &&
+			   model->GetTxdSlot() == modelId-STREAM_OFFSET_TXD)
+				return true;
+		}
+	}
+	return false;
+}
