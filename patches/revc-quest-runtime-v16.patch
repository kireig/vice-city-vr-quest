-// Capture the original contact while its world point and receiver matrix
-// still describe the collision pose. Native records retain only the normal,
-// and deliberately use A's normal for both participants; deformation needs
-// the actual inward direction for each receiver. OFF touches no mesh/state.
+// Every point in a manifold was generated from the same two poses. Native
+// response may roll B back after the first point, so retain those poses before
+// applying any response. This POD copies no matrices or vectors while OFF.
+struct VehicleDeformationCollisionContext {
+	bool active;
+	VehicleDeformation::CollisionPose poseA, poseB;
+	static void Capture(CEntity *entity, VehicleDeformation::CollisionPose &out) {
+		const CVector &right=entity->GetRight(), &forward=entity->GetForward();
+		const CVector &up=entity->GetUp(), &position=entity->GetPosition();
+		out.right[0]=right.x;out.right[1]=right.y;out.right[2]=right.z;
+		out.forward[0]=forward.x;out.forward[1]=forward.y;out.forward[2]=forward.z;
+		out.up[0]=up.x;out.up[1]=up.y;out.up[2]=up.z;
+		out.position[0]=position.x;out.position[1]=position.y;out.position[2]=position.z;
+	}
+	VehicleDeformationCollisionContext(CEntity *A, CEntity *B)
+		: active(VehicleDeformation::IsVehicleDeformationEnabled() &&
+			!A->IsPed() && !B->IsPed() && (A->IsVehicle() || B->IsVehicle())) {
+		if(active) { Capture(A,poseA);Capture(B,poseB); }
+	}
+};
+
+// Normal points inward for A, and outward for B. These optional events are
+// independent of the native strongest damage record; the deformation module
+// already keeps one strongest pending impact per receiver.
 static inline void
 RecordVehicleDeformationCollision(CPhysical *receiver, CEntity *other,
-	const CColPoint &point, float impulse, bool reverseNormal)
+	const CColPoint &point, float impulse, bool reverseNormal,
+	const VehicleDeformation::CollisionPose &pose)
 {
 	if(VehicleDeformation::IsVehicleDeformationEnabled() && receiver->IsVehicle() &&
 	   ((CVehicle*)receiver)->IsCar() && !other->IsPed())
 		VehicleDeformation::RecordCollision((CVehicle*)receiver, point.point,
-			reverseNormal ? -point.normal : point.normal, impulse, other);
+			reverseNormal ? -point.normal : point.normal, impulse, other, &pose);
+}
+
+static inline void
+RecordVehicleDeformationPair(const VehicleDeformationCollisionContext &context,
+	CPhysical *A, CPhysical *B, const CColPoint &point, float impulseA, float impulseB)
+{
+	if(!context.active) return;
+	RecordVehicleDeformationCollision(A,B,point,impulseA,false,context.poseA);
+	RecordVehicleDeformationCollision(B,A,point,impulseB,true,context.poseB);
 }
 
