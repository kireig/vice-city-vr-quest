+static bool
+IsVrVehicleKnockdown(CPed *ped, CVehicle *car, float impulse,
+	const CVector *preCollisionSpeed)
+{
+	// Low bumper contacts can stay below Vice City's canned fall threshold.
+	// Require an actual approaching road-car contact, not walking into a parked
+	// car or an unsupported actor. The solver then decides the resulting pose.
+	if(!preCollisionSpeed || impulse <= 0.0f || !VrRagdoll::IsEnabled() ||
+	   !ped || !car || ped->IsPlayer() || ped->CharCreatedBy != RANDOM_CHAR ||
+	   ped->bInVehicle || ped->bIsInWater || !ped->IsPedInControl() ||
+	   !ped->GetClump() || !car->IsCar() || car->IsRealHeli() || car->IsRealPlane() ||
+	   !car->bUsesCollision || car->bRemoveFromWorld || car->m_fMass <= 0.0f ||
+	   (ped->GetPosition()-TheCamera.GetPosition()).MagnitudeSqr() > 30.0f*30.0f)
+		return false;
+	const CVector offset = ped->GetPosition()-car->GetPosition();
+	const CVector relative = car->m_vecMoveSpeed-*preCollisionSpeed;
+	const float distanceSq = offset.x*offset.x+offset.y*offset.y;
+	const float closing = relative.x*offset.x+relative.y*offset.y;
+	return distanceSq > 0.0001f && closing > 0.0f &&
+		closing*closing > (1.5f/50.0f)*(1.5f/50.0f)*distanceSq;
+}
