+#if defined(GTA_VR_OCULUS) || defined(RW_VULKAN)
+// The reason a drawn-list entity would or would not survive the per-eye test,
+// for the culling visualizer. A read-only twin of ShouldRenderInCurrentView's
+// RW_VULKAN branch: it must not disturb streaming or LOD state.
+int32
+CRenderer::VrClassifyPerView(CEntity *ent)
+{
+#ifdef RW_VULKAN
+	if(ent == nil || ent->m_rwObject == nil)
+		return 1;
+	const bool aggressive =
+		ms_nVrOcclusionCullingMode == VR_OCCLUSION_CULLING_AGGRESSIVE;
+	const float radius = ent->GetBoundRadius();
+	const CVector boundCentre = ent->GetBoundCentre();
+	const float angularMarginTangent =
+		ms_nVrOcclusionCullingMode == VR_OCCLUSION_CULLING_SAFE ?
+		0.14054083f : (aggressive ? 0.05240778f : 0.08748866f);
+	bool stereoVisible = true;
+	if(ent->IsBuilding()){
+		CColModel *colModel = CModelInfo::GetModelInfo(
+			ent->GetModelIndex())->GetColModel();
+		if(colModel != nil){
+			const CVector &boxMin = colModel->boundingBox.min;
+			const CVector &boxMax = colModel->boundingBox.max;
+			float worldCorners[8][3];
+			for(int corner = 0; corner < 8; corner++){
+				const CVector local(
+					(corner & 1) ? boxMax.x : boxMin.x,
+					(corner & 2) ? boxMax.y : boxMin.y,
+					(corner & 4) ? boxMax.z : boxMin.z);
+				const CVector world = ent->GetMatrix()*local;
+				worldCorners[corner][0] = world.x;
+				worldCorners[corner][1] = world.y;
+				worldCorners[corner][2] = world.z;
+			}
+			stereoVisible = rw::vulkan::
+				isFirstPersonWorldBoxVisibleInStereo(
+					worldCorners, angularMarginTangent) != 0;
+		}else
+			stereoVisible = rw::vulkan::
+				isFirstPersonWorldSphereVisibleInStereo(
+					&boundCentre.x, radius,
+					angularMarginTangent) != 0;
+	}else
+		stereoVisible = rw::vulkan::
+			isFirstPersonWorldSphereVisibleInStereo(
+				&boundCentre.x, radius, angularMarginTangent) != 0;
+	if(!stereoVisible)
+		return 1;
+	if(!ent->IsBuilding() ||
+	   ms_nVrOcclusionCullingMode == VR_OCCLUSION_CULLING_SAFE)
+		return 0;
+	if(gQuestOcclusionPreparedFrame != CTimer::GetFrameCounter() ||
+	   gQuestOcclusionPreparedMask != 0x3)
+		return 0;
+	return COcclusion::IsEntityOccludedByVolumeStereo(ent,
+		gQuestOcclusionEyePosition, aggressive) ? 2 : 0;
+#else
+	return 0;
+#endif
+}
+#endif
